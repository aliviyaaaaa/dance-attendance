# Скопируйте этот файл в .env и заполните значения.
# .env никогда не отправляется в git.

# Impulse CRM: пользователь analytics_bot (роль «Аналитик-бот», только просмотр)
IMPULSE_BASE_URL=https://<ваша-студия>.impulsecrm.ru
IMPULSE_LOGIN=
IMPULSE_PASSWORD=
# Или вместо логина и пароля — API-ключ этого пользователя (профиль → «Настройка API»)
IMPULSE_API_KEY=

# Telegram (этап 5)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# LLM: по умолчанию Alice AI LLM Flash через Yandex AI Studio.
# LLM_MODEL — имя модели из каталога AI Studio (например aliceai-llm-flash, yandexgpt-5.1, yandexgpt-5-lite).
# Для другого OpenAI-совместимого провайдера: LLM_PROVIDER=other, LLM_BASE_URL=..., LLM_MODEL=...
LLM_PROVIDER=yandex
LLM_MODEL=aliceai-llm-flash
LLM_BASE_URL=
LLM_API_KEY=
LLM_FOLDER_ID=
