# Скопируйте этот файл в .env и заполните значения.
# .env никогда не отправляется в git.

# Impulse CRM: пользователь analytics_bot (роль «Аналитик-бот», только просмотр)
IMPULSE_BASE_URL=https://<ваша-студия>.impulsecrm.ru
IMPULSE_LOGIN=
IMPULSE_PASSWORD=
# Или вместо логина и пароля — API-ключ этого пользователя (профиль → «Настройка API»)
IMPULSE_API_KEY=

# Telegram (этап 5)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# Postgres на Railway — постоянное хранилище для дашборда студии.
# Railway: Project → Postgres → Variables → DATABASE_URL (или PGHOST/PGUSER/PGPASSWORD/PGDATABASE).
# Supabase: session pooler, потому что прямое подключение идёт по IPv6, а у сети маршрута IPv6 нет.
# Без этой строки бот работает как обычно, просто не выкладывает снимок в дашборд.
DATABASE_URL=

# --- Расписание: бот работает сам, без кнопок (время московское) ---
# SCHEDULE_ENABLED=0 — выключить расписание (например, на тестовой копии)
SCHEDULE_ENABLED=1
TIMEZONE=Europe/Moscow
# Каждый день в это время бот выгружает свежие данные из CRM
SYNC_HOUR=6
SYNC_MINUTE=0
# Отчёт за прошлую неделю: 1 = понедельник
REPORT_WEEKDAY=1
REPORT_HOUR=9
REPORT_MINUTE=0
# Если данные старше этого числа часов, бот обновит их при запуске
SYNC_STALE_HOURS=20
# Сколько недель доливать на пустом сервере при первом запуске
BACKFILL_WEEKS=12

# LLM: по умолчанию Alice AI LLM Flash через Yandex AI Studio.
# LLM_MODEL — имя модели из каталога AI Studio (например aliceai-llm-flash, yandexgpt-5.1, yandexgpt-5-lite).
# Для другого OpenAI-совместимого провайдера: LLM_PROVIDER=other, LLM_BASE_URL=..., LLM_MODEL=...
LLM_PROVIDER=yandex
LLM_MODEL=aliceai-llm-flash
LLM_BASE_URL=
LLM_API_KEY=
LLM_FOLDER_ID=
